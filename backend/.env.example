## Example MongoDB Atlas connection string. Replace <DB_USER> and <PASSWORD> and the host with your cluster values.
# Use the `careerak` database name (or change as needed):
MONGO_URI=mongodb+srv://mimomori81_db_user:NQmL5Cqa7oKGITok@cluster0.p6a4gwq.mongodb.net/

