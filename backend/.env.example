## Example MongoDB Atlas connection string. Replace <DB_USER> and <PASSWORD> and the host with your cluster values.
# Use the `careerak` database name (or change as needed):
MONGO_URI=mongodb+srv://<DB_USER>:<PASSWORD>@cluster0.example.mongodb.net/careerak?retryWrites=true&w=majority

# JWT secret used to sign authentication tokens (keep this secret in production)
JWT_SECRET=replace_with_a_strong_random_secret

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Port the server listens on (default dev port)
PORT=5000
